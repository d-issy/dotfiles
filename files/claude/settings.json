{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh",
    "padding": 0
  },
  "hooks": {
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "tmux-notice on claude-wait"
          }
        ]
      }
    ]
  },
  "deniedMcpServers": [
    { "serverName": "claude.ai Asana" },
    { "serverName": "claude.ai Atlassian" },
    { "serverName": "claude.ai Linear" },
    { "serverName": "claude.ai monday.com" },
    { "serverName": "claude.ai HubSpot" },
    { "serverName": "claude.ai Intercom" },
    { "serverName": "claude.ai Canva" },
    { "serverName": "claude.ai Box" }
  ],
  "permissions": {
    "allow": [
      "Read(~/.claude/skills/**)"
    ],
    "deny": [
      "Read(.env)",
      "Edit(.env)",
      "Read(.env.*)",
      "Edit(.env.*)",
      "Read(.envrc)",
      "Edit(.envrc)",
      "Bash(sudo *)"
    ],
    "ask": [
      "Bash(rm /*)",
      "Bash(rm * /*)",
      "Bash(rm ../*)",
      "Bash(rm * ../*)",
      "Bash(rmdir *)"
    ]
  },
  "outputStyle": "default",
  "includeGitInstructions": false,
  "autoMemoryEnabled": false,
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  }
}
